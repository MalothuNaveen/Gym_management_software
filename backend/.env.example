# ---------------------------------------------------------------------------
# Gym Management System - backend environment
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_ENV=development          # development | production | test
APP_NAME=Gym Management System

# --- Database --------------------------------------------------------------
# Local development (no server needed):
DATABASE_URL=sqlite:///./gym.db
# Production (Neon free tier). Note the +psycopg driver suffix:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Security --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Browser origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://yourgym.pages.dev

# --- First-run owner account (used once, on an empty database) -------------
OWNER_EMAIL=owner@gym.local
OWNER_PASSWORD=ChangeMe123!
OWNER_NAME=Gym Owner

# --- Gym defaults (editable later in Settings) -----------------------------
GYM_NAME=Iron Fitness Gym
GYM_PHONE=
GYM_ADDRESS=
GYM_TIMEZONE=Asia/Kolkata

# --- Photo storage ---------------------------------------------------------
STORAGE_BACKEND=local        # local | gcs
STORAGE_LOCAL_DIR=./uploads
# STORAGE_BACKEND=gcs
# STORAGE_BUCKET=your-private-bucket-name
# On Cloud Run leave this empty and attach a service account instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=8388608     # 8 MB
PHOTO_MAX_DIMENSION=800
PHOTO_JPEG_QUALITY=82
